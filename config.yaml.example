# kahouse Configuration Example
# Copy to config.yaml and modify as needed

kafka_brokers: "localhost:9092"
schema_registry: "http://localhost:8081"
clickhouse_dsn: "tcp://localhost:9000"
group_id: "kahouse"
client_id: "kahouse"            # used as Kafka client.id prefix; per-topic suffix added automatically
dlq_topic_suffix: ".dlq"
input_format: "avro"           # avro | json | string
string_value_column: "value"   # used only when input_format is string
auto_offset_reset: "earliest"  # earliest | latest | none

# Schema Registry authentication (optional — omit for unauthenticated registries)
# For Confluent Cloud, use your Schema Registry API key and secret.
# schema_registry_username: "your-sr-api-key"
# schema_registry_password: "your-sr-api-secret"

# Kafka authentication (optional — omit all fields for unauthenticated clusters)
# Typical values for Confluent Cloud or MSK:
# kafka_security_protocol: "SASL_SSL"
# kafka_sasl_mechanism: "PLAIN"          # or SCRAM-SHA-256 / SCRAM-SHA-512
# kafka_sasl_username: "your-api-key"
# kafka_sasl_password: "your-api-secret"
# kafka_ssl_ca_location: "/path/to/ca.crt"  # only needed for custom CA

# Server settings
metrics_port: 9090

# ClickHouse connection pool
clickhouse_max_open_conns: 5
clickhouse_max_idle_conns: 5
# Recycle pooled connections after this many seconds. ClickHouse Cloud closes idle
# connections server-side; the driver default (1h) is far too long and leads to
# "connection reset by peer" on stale connections. Keep below the server idle timeout.
clickhouse_conn_max_lifetime_s: 300

# ClickHouse async insert settings (opt-in, both default to false)
# clickhouse_async_insert: true
# clickhouse_wait_for_async_insert: true

# Kafka consumer timeout settings
kafka_session_timeout_ms: 45000
kafka_max_poll_interval_ms: 300000

# Global defaults (can be overridden per topic)
batch_size: 10000
batch_delay_ms: 200
max_retries: 5
retry_backoff_ms: 100

# Auto-restart supervision.
# When a sink task stops with a *transient* error (ClickHouse timeout / retriable
# error, transient Kafka commit failure), the supervisor restarts it in place with
# exponential backoff instead of leaving it stopped until an operator intervenes.
# Fatal crashes (poison messages in strict mode, non-retriable ClickHouse errors)
# are never auto-restarted. If a task keeps crash-looping past max_stuck_s, the
# supervisor gives up and fails /livez so Kubernetes recycles the whole pod.
auto_restart:
  enabled: true            # default true; set false to keep the old passive behaviour
  initial_backoff_ms: 5000 # delay before the first restart; doubles each consecutive failure
  max_backoff_ms: 300000   # cap on the restart backoff (5 min)
  reset_after_s: 120       # healthy uptime that resets a task's consecutive-failure counter
  max_stuck_s: 900         # escalate to a pod recycle after this long crash-looping (negative disables)

# Topic discovery: how often topic_patterns (below) are reconciled against the
# Kafka cluster and topics parked as table_missing are retried.
topic_discovery:
  interval_s: 60           # 0 disables the loop; patterns still expand once at startup
  max_topics: 200          # cap on discovered sink tasks (each is a full Kafka consumer)
  timeout_ms: 5000         # per Kafka metadata request / ClickHouse DESCRIBE
# A task younger than this may have no partition assignment yet without failing /readyz.
readiness_grace_s: 30

# For avro input, schema_registry must point at a Confluent-compatible Schema Registry.
# For json and string input, schema_registry is unused.

# Topic-to-table mappings. At least one topic_tables entry or topic_patterns
# entry (see below) must be present.
# Each topic gets its own Kafka consumer and independent batch pipeline.
topic_tables:
  - topic: "orders"
    table: "default.orders"
    format: "json"
    # Optional per-topic overrides. Omit a field to inherit the global default above.
    # Setting a field to 0 is valid and takes effect — 0 is not treated as "not set".
    # Examples:
    # format: "avro"
    # string_value_column: "value"
    # batch_size: 5000
    # batch_delay_ms: 100
    # max_retries: 5
    # retry_backoff_ms: 200

  - topic: "payments"
    table: "default.payments"
    format: "string"
    string_value_column: "value"

  - topic: "users"
    table: "default.users"
    format: "avro"
    # max_retries: 0        # stop on first write failure, no retries
    # batch_delay_ms: 0     # flush as fast as possible, no accumulation delay
    #
    # Optional per-topic starting position. Only applied when the consumer
    # group has no committed offset for a partition; never overrides existing
    # progress, so it is safe across restarts. Set exactly one variant.
    # start_at:
    #   position: earliest                    # earliest | latest
    # start_at:
    #   timestamp: "2026-04-01T00:00:00Z"     # RFC3339
    # start_at:
    #   unix_ms: 1717200000000
    # start_at:
    #   offsets:
    #     0: 12345
    #     1: 9000

  # Tombstones (optional, per-topic). A key + null value message is the deletion
  # marker of a compacted topic. Default is skip (commit and ignore); row writes
  # {key_column: <key>, deleted_column: 1} so a ReplacingMergeTree(<offset>,
  # <deleted>) table read with FINAL drops the key. Requires kafka_metadata.offset.
  # tombstones:
  #   mode: row               # skip | row
  #   key_column: id
  #   deleted_column: _is_deleted

  # Kafka metadata injection (optional, per-topic).
  # Adds Kafka message metadata as extra columns on each row before insert.
  # Equivalent to Kafka Connect's InsertField$Value SMT. Each field is optional:
  # omit a field to skip injecting it. Column names are free-form and must
  # exist in the target ClickHouse table.
  - topic: "orders_enriched"
    table: "default.orders_enriched"
    format: "json"
    kafka_metadata:
      offset:    "__offset"     # int64  -> UInt64 or Int64
      partition: "__partition"  # int32  -> UInt32, Int32, or UInt64
      topic:     "__topic"      # string -> LowCardinality(String) or String
      timestamp: "__timestamp"  # time.Time -> DateTime64(3) or Nullable(DateTime64(3))
      key:       "__key"        # raw bytes as string -> String (or FixedString(N))
      headers:   "__headers"    # map[string]string -> Map(String, String)

  # Example: topic with JSON flattening enabled.
  # Nested JSON objects are collapsed into flat keys joined by the delimiter,
  # matching Kafka Connect's Flatten$Value SMT behavior.
  # - topic: "nested.events"
  #   table: "default.events"
  #   format: "json"
  #   flatten:
  #     enabled: true
  #     delimiter: "_"          # default: "_"
  #     # max_depth: 0          # 0 = unlimited (default)
  #     # preserve_arrays: true # arrays preserved as-is (default)

# Topic patterns: match topics by regex and derive the table from the topic name.
# New topics following the naming convention are picked up at runtime, each with
# its own consumer, consumer group and sink task, so one failing topic never
# affects another. An explicit topic_tables entry always wins over a pattern.
# Patterns match the whole topic name; topics starting with "_" and topics ending
# in dlq_topic_suffix are never matched.
# topic_patterns:
#   - pattern: "prod\\.(?P<domain>[a-z]+)\\.(?P<entity>[a-z_]+)"
#     table: "analytics.${domain}_${entity}"   # prod.hr.employees -> analytics.hr_employees
#     format: "json"                            # any per-topic override from topic_tables applies
#     start_at:
#       position: earliest
#   - pattern: "cdc\\.public\\.(.+)"
#     table: "raw.${1}"                         # cdc.public.invoices -> raw.invoices
#   - pattern: "events\\..*"
#     table: "raw.${0}"                         # ${0} is the whole topic name
#     table_replace: {".": "_"}                 # events.user.signup -> raw.events_user_signup

# Input format notes:
# - avro: ClickHouse columns should match the Avro schema fields.
# - json: JSON objects are decoded generically; integers arrive as Int64 and decimals as Float64.
# - string: create a String column matching string_value_column, for example `value String`.
# Global input_format acts as the default when a topic mapping omits format.
